<odoo>
    <record id="view_legal_court_list" model="ir.ui.view">
        <field name="name">legal.court.list</field>
        <field name="model">legal.court</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="court_type"/>
                <field name="district"/>
                <field name="city"/>
            </list>
        </field>
    </record>

    <record id="view_legal_court_form" model="ir.ui.view">
        <field name="name">legal.court.form</field>
        <field name="model">legal.court</field>
        <field name="arch" type="xml">
            <form string="Juzgado / Tribunal">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="court_type"/>
                        </group>
                        <group>
                            <field name="district"/>
                            <field name="city"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Jueces / Magistrados">
                            <field name="judge_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="position"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_legal_court" model="ir.actions.act_window">
        <field name="name">Juzgados / Tribunales</field>
        <field name="res_model">legal.court</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>